# Copy to .env and edit if you need to. Every value below has a working
# default, so the demo runs with no .env at all.

# Secrets. The defaults are obviously not secret and are fine for a demo.
# A deployment would take all three from a KMS or a secret manager.
BFSI_LEDGER_KEY=demo-ledger-key-not-for-production
BFSI_AES_KEY=demo-aes-key-not-for-production
BFSI_JWT_SECRET=demo-jwt-secret-not-for-production

# Paths. Defaults sit inside the repository.
# BFSI_DATA_DIR=./data
# BFSI_MODEL_DIR=./models
# BFSI_RUNTIME_DIR=./runtime
# BFSI_DB=./runtime/bfsi.db

# Speech recognition. `base` with int8 is the demo default and runs in real
# time on a laptop CPU. `small` is more accurate and roughly three times
# slower. Set BFSI_ASR_DEVICE=cuda and BFSI_ASR_COMPUTE=float16 on a GPU box.
BFSI_ASR_MODEL=base
BFSI_ASR_COMPUTE=int8
BFSI_ASR_DEVICE=cpu

# Stretch goal, GPU only: swap faster-whisper for AI4Bharat IndicConformer and
# report the entity-level error rate delta. Off by default.
BFSI_INDIC_CONFORMER=0

# The Hugging Face Xet transfer backend stalls on some networks. The Makefile
# exports this already; it is repeated here so a manual run behaves the same.
HF_HUB_DISABLE_XET=1
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------- CLU layer
# Optional contextual language understanding. Default is off, which makes the
# system behave exactly like stable-local-2026-09-21/.
#
#   null    off, deterministic classifier only (default)
#   mock    offline keyword rules, for tests. Not a language model.
#   ollama  a model on this machine. Keeps transcripts on the laptop.
#   openai  any OpenAI-compatible endpoint: Groq, OpenRouter, Together, Gemini.
BFSI_CLU_PROVIDER=null

# Groq free tier. Get a key at https://console.groq.com/keys and put it in
# .env (which is gitignored), NOT in this example file.
BFSI_LLM_API_BASE=https://api.groq.com/openai/v1
BFSI_LLM_API_KEY=
BFSI_CLU_MODEL=qwen/qwen3.8-27b

# A hosted provider means routed transcripts leave this machine, which breaks
# the on-premise claim in the synopsis. Every affected turn is marked in its
# trace and the capability registry says so on the dashboard.
# For local instead: BFSI_CLU_PROVIDER=ollama, BFSI_CLU_MODEL=qwen2.5:3b-instruct

# ---------------------------------------------------------------- voice
# female | male. Honoured by every engine and every language. Piper has no
# female Hindi voice in the downloaded set, so the Piper fallback cannot
# honour this for Hindi or Marathi; Kokoro and ElevenLabs can.
BFSI_TTS_GENDER=female

# indian | neutral. Indian English comes from a Hindi Kokoro voice reading
# English through the ENGLISH phonemiser. Those are two different settings:
# running English text through the Hindi phonemiser gives you an accent and
# destroys the words (round-trip WER 0.48 against 0.29).
BFSI_TTS_ACCENT=indian

# Phrase-by-phrase synthesis with real pauses, slight speed variation and an
# occasional breath before a long sentence. Set to 0 to hear the difference.
BFSI_TTS_PAUSES=1
BFSI_TTS_BREATHS=1

# auto | elevenlabs | kokoro | piper. auto picks ElevenLabs if a key is set,
# then Kokoro, then Piper.
BFSI_TTS_ENGINE=auto

# ElevenLabs, optional and paid beyond a small free tier. Most natural of the
# three. It sends the REPLY TEXT to a third party, and a reply can contain a
# balance or an account's last four, so that is customer data leaving the
# machine. Every affected turn records it.
# BFSI_ELEVENLABS_API_KEY=
# BFSI_ELEVENLABS_MODEL=eleven_turbo_v2_5
# Voice ids from https://elevenlabs.io/app/voice-library, filtered to Indian
# English. The default is a placeholder: pick one you like and set it here.
# BFSI_ELEVENLABS_VOICE_EN=
# BFSI_ELEVENLABS_VOICE_HI=

# Sarvam AI, optional and paid. Built for Indian languages and the
# recommended primary for Hindi, Marathi and Indian English: it handles
# Hinglish at the model level and pronounces Indian names and places
# correctly, which the local stack does not.
#
# Nothing in this repository has ever run against it, because there is no key
# here. The registry lists it SIMULATED for exactly that reason, and it will
# stay SIMULATED until a key exists and the calls have actually been made.
# BFSI_SARVAM_API_KEY=
#
# TTS: it sends the REPLY TEXT off this machine, and a reply can contain a
# balance or an account's last four.
# STT: it sends the CALLER'S AUDIO off this machine, which is a stronger
# disclosure again. Both are listed separately in the capability registry
# because they are different promises to break.

# Which provider speaks each language. Anything not set uses the local stack,
# so a fresh clone with no keys behaves exactly like the frozen snapshot.
# Values: local, sarvam, elevenlabs
# BFSI_TTS_PROVIDER_EN=local
# BFSI_TTS_PROVIDER_HI=local
# BFSI_TTS_PROVIDER_MR=local
# How long a cloud provider may take to start speaking before the turn gives
# up and speaks locally. The local first phrase is about 1.3 s (RESULTS.md),
# so a cloud call that cannot beat this is not earning the data it sends.
# BFSI_TTS_FALLBACK_TTFB_MS=1500

# ---------------------------------------------------------------- presenter
# Your name on screen for a live demo. Read at runtime, never committed,
# because the repository rule is that no real personal data lives in it.
# BFSI_PRESENTER_NAME=
