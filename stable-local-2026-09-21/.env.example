# Copy to .env and edit if you need to. Every value below has a working
# default, so the demo runs with no .env at all.

# Secrets. The defaults are obviously not secret and are fine for a demo.
# A deployment would take all three from a KMS or a secret manager.
BFSI_LEDGER_KEY=demo-ledger-key-not-for-production
BFSI_AES_KEY=demo-aes-key-not-for-production
BFSI_JWT_SECRET=demo-jwt-secret-not-for-production

# Paths. Defaults sit inside the repository.
# BFSI_DATA_DIR=./data
# BFSI_MODEL_DIR=./models
# BFSI_RUNTIME_DIR=./runtime
# BFSI_DB=./runtime/bfsi.db

# Speech recognition. `base` with int8 is the demo default and runs in real
# time on a laptop CPU. `small` is more accurate and roughly three times
# slower. Set BFSI_ASR_DEVICE=cuda and BFSI_ASR_COMPUTE=float16 on a GPU box.
BFSI_ASR_MODEL=base
BFSI_ASR_COMPUTE=int8
BFSI_ASR_DEVICE=cpu

# Stretch goal, GPU only: swap faster-whisper for AI4Bharat IndicConformer and
# report the entity-level error rate delta. Off by default.
BFSI_INDIC_CONFORMER=0

# The Hugging Face Xet transfer backend stalls on some networks. The Makefile
# exports this already; it is repeated here so a manual run behaves the same.
HF_HUB_DISABLE_XET=1
TOKENIZERS_PARALLELISM=false
